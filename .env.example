# Copy to .env (cp .env.example .env  |  PowerShell: Copy-Item .env.example .env)
MYSQL_ROOT_PASSWORD=root-dev-password
USER_DB_PASSWORD=user-dev-password
EVENT_DB_PASSWORD=event-dev-password
BOOKING_DB_PASSWORD=booking-dev-password
PAYMENT_DB_PASSWORD=payment-dev-password
ADMIN_EMAIL=admin@ticketrush.dev
ADMIN_PASSWORD=Admin#12345
# Service-to-service token secret (>= 32 bytes). Used from plan 2 by event/booking/payment only.
INTERNAL_JWT_SECRET=dev-internal-secret-change-me-0123456789
# RSA key pair for user tokens (generate with infra/keys/generate-dev-keys.sh|.ps1)
JWT_PRIVATE_KEY_FILE=./infra/keys/private/jwt-private.pem
JWT_PUBLIC_KEY_FILE=./infra/keys/public/jwt-public.pem
# Only ai-assistant reads this (plan 7).
ANTHROPIC_API_KEY=
